---
import type { CollectionEntry } from "astro:content";
import Base from "./Base.astro";
import TipFooter from "../components/TipFooter.astro";
import TipHeader from "../components/TipHeader.astro";
import { formatNumber, permalinkOf } from "../lib/numbers";

type Props = Pick<
  CollectionEntry<"tips">["data"],
  "number" | "topic" | "category" | "takeaway"
>;

const { number, topic, category, takeaway } = Astro.props;

const permalink = permalinkOf("tip", number);
const imagePath = `/en/tips/${formatNumber(number)}/card.png`;
const imageName = `code-a-la-carte-tip-${formatNumber(number)}.png`;
---

<Base title={takeaway}>
  <main>
    <article>
      <TipHeader category={category} takeaway={takeaway} topic={topic} />
      <slot />
      <TipFooter
        permalink={permalink}
        imagePath={imagePath}
        imageName={imageName}
      />
    </article>
  </main>
</Base>
