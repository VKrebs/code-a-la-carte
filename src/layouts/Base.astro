---
import SiteFooter from "../components/SiteFooter.astro";
import Head from "../components/Head.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <Head title={title} />
  </head>
  <body>
    <slot />
    <SiteFooter />
  </body>
</html>
<style>
  body {
    margin: 0 auto;
    max-width: 64rem;
    padding: 2rem clamp(1rem, 5vw, 4rem);
    box-sizing: border-box;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
</style>
