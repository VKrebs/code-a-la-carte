---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <main>
    <p class="error-code" aria-hidden="true">
      404.
    </p>
    <div>
      <h1>Oops! Looks like this page isn't on the menu.</h1>
      <p class="subtitle">
        The link may be mistyped, or this dish isn't served yet.
      </p>
    </div>
    <a class="button" href="/">
      Back to the home page
    </a>
  </main>
</Base>
<style>
  main {
    min-height: 80svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 2rem;
  }

  .error-code {
    margin: 0;
    padding: 0.35em 0.8em 0.3em;
    background-color: var(--brand-orange);
    border: 4px solid var(--ink);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--ink);
    font-size: clamp(2rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    line-height: 1;
    white-space: nowrap;
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0;
    max-width: 20ch;
    line-height: 1.1;
    text-wrap: balance;
  }

  .button {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
  }

  .subtitle {
    color: var(--muted);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    margin: 0;
  }
</style>
