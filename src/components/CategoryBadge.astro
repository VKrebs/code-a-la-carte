---
import type { Category } from "../content.config";

type TextColor = "var(--ink)" | "var(--white)";

interface Props {
  category: Category;
}

const categoriesColors: Record<
  Category,
  { background: string; text: TextColor }
> = {
  Craft: { background: "var(--category-craft)", text: "var(--white)" },
  Tooling: { background: "var(--category-tooling)", text: "var(--ink)" },
  Testing: { background: "var(--category-testing)", text: "var(--ink)" },
  Design: { background: "var(--category-design)", text: "var(--white)" },
  Collaboration: {
    background: "var(--category-collaboration)",
    text: "var(--white)",
  },
  Platform: { background: "var(--category-platform)", text: "var(--white)" },
  Architecture: {
    background: "var(--category-architecture)",
    text: "var(--ink)",
  },
};

const { category } = Astro.props;
const backgroundColor = categoriesColors[category].background;
const textColor = categoriesColors[category].text;
---

<span class="badge">{category}</span>
<style define:vars={{ backgroundColor, textColor }}>
  .badge {
    display: inline-block;
    padding: 0.35em 0.8em 0.3em;
    border: 3px solid var(--ink);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.875rem;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    white-space: nowrap;
    background: var(--backgroundColor);
    color: var(--textColor);
  }
</style>
