---
interface Props {
  permalink: string;
}

const { permalink } = Astro.props;

const reportUrl = new URL(
  "https://github.com/VKrebs/code-a-la-carte/issues/new",
);
reportUrl.searchParams.set("template", "erratum.yml");
reportUrl.searchParams.set("page", `codealacarte.dev/${permalink}`);
---

<footer>
  <p>codealacarte.dev/{permalink}</p>
  <a href={reportUrl.href}>Report an error</a>
</footer>
<style>
  footer {
    color: var(--muted);
  }
</style>
