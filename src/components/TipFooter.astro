---
import { displayUrlOf } from "../lib/urls";

interface Props {
  permalink: URL;
  imagePath: string;
  imageName: string;
}

const { permalink, imagePath, imageName } = Astro.props;

const displayedPermalink = displayUrlOf(permalink);
const reportUrl = new URL(
  "https://github.com/VKrebs/code-a-la-carte/issues/new",
);
reportUrl.searchParams.set("template", "erratum.yml");
reportUrl.searchParams.set("page", displayedPermalink);
---

<footer>
  <p>{displayedPermalink}</p>
  <a href={reportUrl.href}>Report an error</a>
  <a href={imagePath} download={imageName}>
    Download as an image (PNG)
  </a>
</footer>
<style>
  footer {
    color: var(--muted);
  }
</style>
