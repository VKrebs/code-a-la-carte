---
import { displayUrlOf } from "../lib/urls";
import DownloadIcon from "@phosphor-icons/core/assets/bold/download-simple-bold.svg";

interface Props {
  permalink: URL;
  imagePath: string;
  imageName: string;
}

const { permalink, imagePath, imageName } = Astro.props;

const displayedPermalink = displayUrlOf(permalink);
const reportUrl = new URL(
  "https://github.com/VKrebs/code-a-la-carte/issues/new",
);
reportUrl.searchParams.set("template", "erratum.yml");
reportUrl.searchParams.set("page", displayedPermalink);
---

<footer>
  <p>{displayedPermalink}</p>
  <div class="actions-row">
    <a class="button" href={imagePath} download={imageName}>
      <DownloadIcon aria-hidden="true" width="1.25em" height="1.25em" />
      Download as an image (PNG)
    </a>
    <a href={reportUrl.href}>Report an error</a>
  </div>
</footer>
<style>
  footer {
    margin-top: 44px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--muted);
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .actions-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
</style>
