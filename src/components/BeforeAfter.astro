---
interface Props {
  beforeLabel?: string;
  afterLabel?: string;
}

const { beforeLabel = "Before", afterLabel = "After" } = Astro.props;
---

<div class="before-after-frame">
  <div class="before-after">
    <figure>
      <figcaption>{beforeLabel}</figcaption>
      <slot name="before" />
    </figure>
    <figure class="after-side">
      <figcaption>{afterLabel}</figcaption>
      <slot name="after" />
    </figure>
  </div>
</div>
<style>
  .before-after-frame {
    container-type: inline-size;
  }

  .before-after {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-inline-end: var(--shadow-offset);
    gap: 40px;
    align-items: stretch;
  }

  @container (min-width: 48rem) {
    .before-after {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  figure {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    margin: 0 0 14px 0;
  }

  figcaption::before {
    content: "";
    box-sizing: border-box;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    border: 3px solid var(--ink);
    border-radius: 50%;
  }

  figure :global(pre) {
    margin: 0;
    padding: 24px 26px;
    border: 4px solid var(--ink);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--ink);
    flex: 1;
  }

  figure :global(pre:focus-visible) {
    outline: 2px solid transparent;
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--brand-orange);
  }

  figure > :global(*:not(figcaption)) {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .after-side figcaption::before {
    background: var(--ink);
  }
</style>
