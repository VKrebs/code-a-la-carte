{
  "name": "code-a-la-carte",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npx wrangler dev",
    "check": "astro check",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:html": "astro build && html-validate \"dist/**/*.html\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "html-validate": "11.17.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  },
  "license": "MIT"
}
